# API Gateway — copy to .env and adjust
JWT_SECRET="healthmate_jwt_secret_dev"
PORT=8080
API_PREFIX="/api/v1"

# Auth service: khi chạy gateway NGOÀI Docker dùng localhost; trong Docker dùng tên service
AUTH_HTTP_URL="http://localhost:5000"
# AUTH_HTTP_URL="http://DACN-auth-service:5000"

REALTIME_HTTP_URL="http://localhost:5001"
# Trong Docker Compose (cùng network backend): dùng tên service hoặc container
STORAGE_HTTP_URL="http://localhost:5003"
# STORAGE_HTTP_URL="http://storage-service:5003"
# STORAGE_HTTP_URL="http://DACN-storage-service:5003"

# OCR service (FastAPI). Trong Docker Compose: http://ocr-service:8010
OCR_HTTP_URL="http://localhost:8010"
# OCR_HTTP_URL="http://ocr-service:8010"

KAFKA_BROKER_URL="localhost:9092"
KAFKA_TOPIC="health_metrics"
